# 默认使用 QQ 官方机器人；npm run login 可直接扫码获取应用凭据，无需 NapCat
QQ_TRANSPORT=official
QQBOT_APP_ID=
QQBOT_APP_SECRET=
# 官方用户和群使用 OpenID，不是 QQ 号。扫码返回操作者 OpenID 时会自动填写用户白名单。
# 未返回时会填 bootstrap-deny-all；启动后给机器人发消息，从拒绝日志获取自己的 OpenID。
QQBOT_ALLOWED_USER_IDS=
QQBOT_ALLOWED_GROUP_IDS=
# 仅在应用已具备主动消息权限时开启；平台仍可能限制次数/目标/内容。
# 默认仅尝试有限的被动回复；长任务结果可发 /history 查看，定时结果保留在数据库。
QQBOT_ALLOW_PROACTIVE=false

# ===== 以下仅用于 QQ_TRANSPORT=onebot 的旧 NapCat 接入 =====
# NapCat / OneBot v11 正向 WebSocket 服务（不是反向 WS）
ONEBOT_WS_URL=ws://127.0.0.1:3001
# 必填：与 NapCat WebSocket 服务设置的 token 一致
ONEBOT_ACCESS_TOKEN=
# 扫码入口：NapCat WebUI（不是 OneBot WS 地址）；WebUI token 在网页输入
NAPCAT_WEBUI_URL=http://127.0.0.1:6099
# npm run login:onebot 在登录成功后自动填写；启动/重连时校验机器人身份
QQ_BOT_ID=

# 必填：允许控制 Claude 的用户 QQ 号；多个使用英文逗号分隔
QQ_ALLOWED_USER_IDS=
# 允许接入的 QQ 群号；留空禁用所有群聊，群内仍检查用户白名单
QQ_ALLOWED_GROUP_IDS=
# 群聊命令、审批、普通消息默认都必须 @机器人
QQ_GROUP_REQUIRE_AT=true
# 进度最小发送间隔；QQ 无法像企微一样原地刷新消息
QQ_PROGRESS_INTERVAL_MS=15000
# 所有出站 QQ 消息共用的最小发送间隔
QQ_SEND_INTERVAL_MS=1100
# UTF-8 字节分段上限（256–3800）
QQ_MESSAGE_MAX_BYTES=3800

# ===== 两种通道共用 =====
# 必填：Claude 操作的具体仓库绝对路径，不要填 ~ 或 /
CLAUDE_WORKSPACE=
# 留空仅允许工作目录；可填多个绝对路径，以逗号分隔；* 表示不限制
CLAUDE_ALLOWED_PATHS=
# default / acceptEdits / auto（auto 支持情况取决于 Claude 账号及模型） agent权限执行代码是否需要授权
CLAUDE_PERMISSION_MODE=default
CLAUDE_MAX_TURNS=30
# 留空：官方使用 data/qqbot-<AppID>.sqlite，OneBot 使用 data/tickets.sqlite
# 不要与其他应用或进程共享数据库
TICKET_DB_PATH=
SESSION_TTL_MS=1800000
APPROVAL_TIMEOUT_MS=300000
READ_ONLY_TOOLS=Read,Glob,Grep,LS,NotebookRead,WebFetch,WebSearch,TodoWrite,Task
DENIED_TOOLS=
BASH_READONLY_AUTO_APPROVE=true

SCHEDULE_CONCURRENCY=4
SCHEDULE_MAX_TURNS=100
SCHEDULE_DELIVERY_CONCURRENCY=4
SCHEDULE_TIMEOUT_MS=1800000
SCHEDULE_TIMEZONE=Asia/Shanghai
